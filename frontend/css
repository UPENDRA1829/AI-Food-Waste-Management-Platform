

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  --green: #176b4d;
  --green-dark: #103f30;
  --green-light: #e8f5ed;
  --lime: #d7ef98;
  --ink: #172b24;
  --muted: #66756e;
  --cream: #fafbf7;
  --white: #fff;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: 'DM Sans', sans-serif;
  color: var(--ink);
  background: var(--cream);
}
a { text-decoration: none; color: inherit; }
.container { width: min(1160px, 90%); margin: auto; }

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(255,255,255,.96);
  border-bottom: 1px solid #e9eee8;
  backdrop-filter: blur(14px);
}
.navbar {
  min-height: 84px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
}
.brand {
  font-family: Manrope, sans-serif;
  font-size: 25px;
  font-weight: 800;
  letter-spacing: -1.2px;
  color: var(--green-dark);
}
.brand-icon { color: #56a874; }
.brand-dot { color: #7ab75e; }
.nav-links { display: flex; gap: 32px; }
.nav-links a { font-size: 14px; font-weight: 600; color: #4d6056; }
.nav-links a:hover { color: var(--green); }

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  padding: 13px 22px;
  border-radius: 11px;
  font-weight: 700;
  font-size: 14px;
  transition: .2s ease;
}
.btn:hover { transform: translateY(-2px); }
.btn-primary { background: var(--green); color: white; }
.btn-primary:hover { background: var(--green-dark); }
.btn-outline { border: 1px solid #cddbd0; color: var(--green-dark); }
.btn-outline:hover { background: white; }
.btn-large { padding: 17px 25px; }
.btn-light { background: white; color: var(--green-dark); }

.hero {
  padding: 90px 0 100px;
  background: radial-gradient(circle at 85% 20%, #e6f3d9, transparent 38%), var(--cream);
}
.hero-grid {
  display: grid;
  grid-template-columns: 1.08fr 1fr;
  align-items: center;
  gap: 60px;
}
.eyebrow, .section-kicker {
  color: var(--green);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.8px;
}
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: var(--green-light);
  padding: 11px 16px;
  border-radius: 30px;
}
.pulse-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #39a76a;
}
.hero h1 {
  font-family: Manrope, sans-serif;
  font-size: clamp(43px, 5vw, 68px);
  line-height: 1.14;
  letter-spacing: -3px;
  margin: 26px 0;
}
h1 em, h2 em {
  font-style: normal;
  color: var(--green);
}
.hero p {
  color: var(--muted);
  font-size: 17px;
  line-height: 1.85;
  max-width: 520px;
}
.hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 32px; }
.hero-trust { margin-top: 35px; font-size: 13px; color: #77847b; }
.trust-icon { color: var(--green); }
.trust-separator { margin: 0 12px; }

.hero-visual { position: relative; min-height: 480px; }
.hero-photo {
  height: 480px;
  border-radius: 32px 100px 32px 100px;
  background:
    linear-gradient(180deg,transparent 55%,rgba(9,50,33,.23)),
    url('https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1200&q=85') center/cover;
  box-shadow: 0 28px 65px #153c2426;
}
.floating-card {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 12px;
  background: white;
  padding: 16px 20px;
  border-radius: 16px;
  box-shadow: 0 12px 38px #183e2522;
}
.floating-card strong { display: block; font-size: 14px; }
.floating-card small { display: block; margin-top: 4px; color: var(--muted); }
.floating-emoji { font-size: 26px; }
.floating-top { top: 55px; right: -25px; }
.floating-bottom { bottom: 40px; left: -35px; }

.stats-strip { background: var(--green-dark); color: white; }
.stats-grid { display: grid; grid-template-columns: repeat(3,1fr); }
.stats-grid > div { display: flex; align-items: center; gap: 17px; padding: 30px; border-right: 1px solid #ffffff25; }
.stats-grid strong { font-size: 27px; color: var(--lime); }
.stats-grid span { font-size: 14px; }

.section { padding: 100px 0; }
.section-heading { max-width: 670px; margin-bottom: 40px; }
.section-heading.centered { margin: 0 auto 48px; text-align: center; }
.section-heading h2 {
  font-family: Manrope, sans-serif;
  font-size: clamp(31px,4vw,46px);
  line-height: 1.25;
  letter-spacing: -1.7px;
  margin: 14px 0;
}
.section-heading p { color: var(--muted); line-height: 1.85; font-size: 16px; }
.about-section { background: white; padding-bottom: 70px; }
.features-section { background: #f2f7f0; }

.feature-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }
.feature-card {
  background: white;
  padding: 28px;
  border: 1px solid #e4ede4;
  border-radius: 20px;
  transition: .2s;
}
.feature-card:hover, .role-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 35px #244c3012;
}
.feature-icon { font-size: 32px; }
.feature-card h3 { font-size: 18px; margin: 25px 0 12px; }
.feature-card p { color: var(--muted); font-size: 14px; line-height: 1.8; min-height: 125px; }
.feature-tag { font-size: 11px; color: var(--green); font-weight: 800; letter-spacing: 1.3px; }

.how-section { background: white; }
.steps-grid, .role-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.step-card { padding: 30px; border-top: 2px solid #d6e8d9; }
.step-number { font-size: 48px; font-weight: 800; color: #b9d9be; }
.step-card h3 { font-size: 21px; margin: 22px 0 10px; }
.step-card p { color: var(--muted); line-height: 1.8; }

.roles-section { background: #f3f7f0; }
.role-card {
  background: white;
  border: 1px solid #e2eae0;
  border-radius: 22px;
  padding: 34px;
  transition: .2s;
}
.role-icon { font-size: 38px; }
.role-card h3 { margin: 24px 0 12px; font-size: 20px; }
.role-card p { font-size: 14px; line-height: 1.8; color: var(--muted); min-height: 76px; }
.role-link { color: var(--green); font-weight: 800; font-size: 14px; }

.cta-section { padding: 75px 0; background: var(--green-dark); color: white; }
.cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 30px; }
.cta-inner h2 { font-size: 52px; line-height: 1.15; letter-spacing: -2px; margin: 15px 0; }
.cta-inner p { color: #c5d8ca; }
.cta-section .section-kicker { color: var(--lime); }

.footer { background: white; padding: 35px 0; }
.footer-inner { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
.footer-inner > span { font-size: 12px; color: var(--muted); }

@media(max-width:950px) {
  .nav-links { display: none; }
  .hero-grid { grid-template-columns: 1fr; }
  .hero-visual { max-width: 650px; width: 100%; margin: auto; }
  .feature-grid { grid-template-columns: repeat(2,1fr); }
}
@media(max-width:650px) {
  .navbar { min-height: 72px; }
  .brand { font-size: 21px; }
  .nav-cta { padding: 11px 13px; font-size: 12px; }
  .hero { padding: 60px 0; }
  .hero h1 { letter-spacing: -1.7px; }
  .hero-visual { min-height: 340px; }
  .hero-photo { height: 340px; border-radius: 22px 60px; }
  .floating-top { right: -5px; top: 20px; }
  .floating-bottom { left: -5px; bottom: 15px; }
  .stats-grid, .steps-grid, .role-grid, .feature-grid { grid-template-columns: 1fr; }
  .stats-grid > div { padding: 18px; border-bottom: 1px solid #ffffff25; }
  .section { padding: 65px 0; }
  .feature-card p, .role-card p { min-height: 0; }
  .cta-inner, .footer-inner { flex-direction: column; align-items: flex-start; }
  .cta-inner h2 { font-size: 40px; }
}
